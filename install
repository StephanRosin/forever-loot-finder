#!/usr/bin/env bash
# Copy the addon into a WoW AddOns folder.
#   ./install "<path to>/_forever_/Interface/AddOns"
set -eu
DEST="${1:?usage: ./install <AddOns folder>}"
[ -d "$DEST" ] || { echo "Not a directory: $DEST" >&2; exit 1; }
HERE="$(cd "$(dirname "$0")" && pwd)"
TARGET="$DEST/ForeverLootFinder"
rm -rf "$TARGET"
mkdir -p "$TARGET"
# Files listed in the TOC plus the TOC itself; nothing else ships.
cp "$HERE/ForeverLootFinder.toc" "$TARGET/"
grep -v '^\s*#' "$HERE/ForeverLootFinder.toc" | grep -v '^\s*$' | tr -d '\r' | while read -r f; do
    f="${f//\\//}"
    mkdir -p "$TARGET/$(dirname "$f")"
    cp "$HERE/$f" "$TARGET/$f"
done
# The themes' textures and fonts (with their licence), in the embedded
# LibForeverThemes.
cp -r "$HERE/Libs/LibForeverThemes/Media" "$TARGET/Libs/LibForeverThemes/"
# The rendered profession loops (built from art/ by art/pack.py).
mkdir -p "$TARGET/Media"
cp -r "$HERE/Media/Professions" "$TARGET/Media/"
# Classic's window: ring, shadow and corner masks (Border.lua, Corners.lua).
cp -r "$HERE/Media/Frame" "$TARGET/Media/"
# The sort icon (Forever Quest Log's own drawing).
cp "$HERE/Media/IconSort.tga" "$TARGET/Media/"
echo "Installed to $TARGET"
